    "@vibe-code/core": "workspace:*",
    "@vibe-code/shared": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ansi-to-html": "^0.7.2",
    "diff2html": "^3.4.56",
    "react": "19.3.1",
